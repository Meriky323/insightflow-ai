{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insightflow-ai",
  "main": "cloudflare/worker-built.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-09-01",
  "assets": {"directory": "./cloudflare/public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "workers_dev": true
}
