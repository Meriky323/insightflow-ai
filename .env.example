# Required for live real-data collection
SERPAPI_API_KEY=

# Optional AI engine (OpenAI-compatible).
# For local Sub2API, a typical base URL is http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Public hosting: browser-side secret editing is disabled.
PUBLIC_DEPLOYMENT=0

# Keep live API-consuming research OFF on a public portfolio demo by default.
# Use saved/snapshot research for recruiters; enable only when you explicitly want public users to spend quota.
ALLOW_PUBLIC_LIVE_RESEARCH=0

# Optional persistent data directory. Railway Volume sets
# RAILWAY_VOLUME_MOUNT_PATH automatically when attached.
DATA_DIR=

# Local cache for repeated identical SerpApi requests (seconds). Default: 21600 = 6h.
SERPAPI_CACHE_TTL_SECONDS=21600
